# CIIS API — environment configuration example.
# Copy to `.env` and load it (e.g. `set -a; source .env; set +a`) before running.
# Dev works with NO env at all; the values below are for a real deployment.

# --- Core ---
CIIS_DEBUG=0                                   # 0 = production (enables security headers)
CIIS_SECRET_KEY=change-me-to-a-long-random-string
CIIS_ALLOWED_HOSTS=ciis.example.gov,localhost

# Standalone case assistant. Keep its Chroma/Torch dependencies outside the
# PaddleOCR platform environment.
CIIS_RAG_ENABLED=1
CIIS_RAG_PYTHON=/srv/ciis/.venv-rag/bin/python
CIIS_RAG_STORAGE_DIR=/srv/ciis/rag_assistant_engine/storage
CIIS_RAG_COMMAND_TIMEOUT=330
CIIS_CORS_ORIGINS=https://ciis.example.gov

# --- Forensic engine location (read-only) ---
CIIS_ENGINE_ROOT=/srv/ciis/evidence_ocr_engine
EVIDENCE_STORAGE_DIR=/srv/ciis/evidence_ocr_engine/storage
EVIDENCE_OCR_LANG=ne

# --- Workflow database ---
# Default is SQLite (no vars needed). For Postgres:
CIIS_DB_ENGINE=postgres
CIIS_DB_NAME=ciis
CIIS_DB_USER=ciis
CIIS_DB_PASSWORD=change-me
CIIS_DB_HOST=127.0.0.1
CIIS_DB_PORT=5432

# --- Static / media ---
CIIS_STATIC_ROOT=/srv/ciis/staticfiles
CIIS_MEDIA_ROOT=/srv/ciis/media

# --- TLS / logging ---
CIIS_SSL_REDIRECT=1        # set 0 if TLS is terminated at a reverse proxy without redirect
CIIS_HSTS_SECONDS=31536000
CIIS_LOG_LEVEL=INFO

# --- Pipeline behaviour ---
CIIS_RUN_FULL_PIPELINE=1   # 0 = legacy OCR-only upload path

# --- ML threat intelligence (optional) ---
# 1 = score URL entities with the trained phishing classifier in
# threat_intelligence_system/. Requires that repo's deps (scikit-learn, xgboost,
# pandas, tldextract, python-Levenshtein, …) and a model artifact in its
# checkpoints/. Loads lazily and degrades to the static indicator file if absent.
CIIS_ML_THREAT_INTEL=0
CIIS_THREAT_INTEL_ROOT=/srv/ciis/threat_intelligence_system
CIIS_THREAT_INTEL_MODEL=xgboost
