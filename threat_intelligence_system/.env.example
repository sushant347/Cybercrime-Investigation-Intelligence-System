# Phishing URL Detection Engine - Environment Configuration
# Copy this file to .env and fill in your values.

# ============================================================
# Threat Intelligence API Keys
# ============================================================

# VirusTotal API Key (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# MaxMind GeoIP2 License Key (https://www.maxmind.com/en/accounts/current/license-key)
MAXMIND_LICENSE_KEY=

# ============================================================
# Dataset Paths
# ============================================================

# Directory scanned by the automatic dataset discovery engine.
# All training data is read from here; supports CSV/TSV/TXT/JSON/JSONL/XLSX.
# Relative paths are resolved against the project root.
DATASET_PATH=../sample

# Class-balance guard: downsample the majority class when the
# majority/minority ratio exceeds this value (applied to training data).
BALANCE_MAX_RATIO=1.5

# Optional cap on total rows used for training (0 = use everything)
MAX_TRAINING_ROWS=0

# Path to raw dataset directory (legacy loaders only)
RAW_DATA_DIR=../threat-intelligent-system/raw

# Path to processed dataset directory
PROCESSED_DATA_DIR=./data/processed

# ============================================================
# Model Configuration
# ============================================================

# Default model type: xgboost | lightgbm | random_forest | distilbert | bert | roberta
DEFAULT_MODEL_TYPE=xgboost

# Checkpoint directory
CHECKPOINT_DIR=./checkpoints

# Results directory
RESULTS_DIR=./results

# ============================================================
# Training Configuration
# ============================================================

# Random seed for reproducibility
RANDOM_SEED=42

# Stratified K-Fold cross-validation folds
CV_FOLDS=5

# Stratified row cap for the CV stage only (0 = full training split)
CV_SAMPLE_SIZE=0

# Optuna hyperparameter optimization trials per model
OPTUNA_TRIALS=25

# Stratified row cap for tuning trials only (0 = full training split)
TUNING_SAMPLE_SIZE=0

# Early-stopping patience for gradient-boosting trials
EARLY_STOPPING_ROUNDS=30

# URLs per feature-extraction chunk (bounds memory on huge datasets)
EXTRACTION_CHUNK_SIZE=50000

# Dataset split ratios
TRAIN_RATIO=0.70
VALIDATION_RATIO=0.15
TEST_RATIO=0.15

# Tranco sample size (number of legitimate domains to sample)
TRANCO_SAMPLE_SIZE=300000

# ============================================================
# Transformer Training
# ============================================================

# Batch size for transformer training
TRANSFORMER_BATCH_SIZE=32

# Learning rate
TRANSFORMER_LEARNING_RATE=2e-5

# Number of epochs
TRANSFORMER_EPOCHS=5

# Enable mixed precision training (true/false)
MIXED_PRECISION=true

# Early stopping patience
EARLY_STOPPING_PATIENCE=3

# ============================================================
# Logging
# ============================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty for console only)
LOG_FILE=
