CIIS_RAG_STORAGE_DIR=./storage
CIIS_RAG_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CIIS_RAG_OLLAMA_MODEL=llama3.2:1b
CIIS_RAG_OLLAMA_HOST=http://127.0.0.1:11434
CIIS_RAG_TIMEOUT=300
# Reasoning is optional and is disabled for responsive CPU inference.
CIIS_RAG_OLLAMA_THINK=0
CIIS_RAG_OLLAMA_NUM_PREDICT=256
CIIS_RAG_OLLAMA_KEEP_ALIVE=10m
CIIS_RAG_TOP_K=7
CIIS_RAG_CANDIDATE_MULTIPLIER=3
CIIS_RAG_MINIMUM_RELEVANCE=0.18
CIIS_RAG_CHUNK_SIZE=2400
CIIS_RAG_CHUNK_OVERLAP=240
# Keep 0 unless Ollama is on a trusted non-loopback host.
CIIS_RAG_ALLOW_REMOTE_OLLAMA=0
